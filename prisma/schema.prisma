generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Release {
  id          String      @id @default(cuid())
  slug        String      @unique
  titleJp     String      @map("title_jp")
  titleRomaji String      @map("title_romaji")
  titleEn     String?     @map("title_en")
  releaseDate DateTime    @map("release_date")
  type        ReleaseType
  coverArt    String?     @map("cover_art")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tracks      TrackOnRelease[]

  @@map("releases")
}

model Song {
  id           String   @id @default(cuid())
  slug         String   @unique
  titleJp      String   @map("title_jp")
  titleRomaji  String   @map("title_romaji")
  titleEn      String?  @map("title_en")
  lyricsJp     String   @map("lyrics_jp")
  lyricsRomaji String   @map("lyrics_romaji")
  lyricsEn     String   @map("lyrics_en")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  releases     TrackOnRelease[]

  @@map("songs")
}

model TrackOnRelease {
  id          String  @id @default(cuid())
  releaseId   String  @map("release_id")
  songId      String  @map("song_id")
  trackNumber Int     @map("track_number")

  release     Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  song        Song    @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([releaseId, songId])
  @@unique([releaseId, trackNumber])
  @@map("tracks_on_releases")
}

enum ReleaseType {
  ALBUM
  EP
  SINGLE
}

// ============================================
// COMMUNITY FEATURES
// ============================================

model ForumCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  nameJp      String?       @map("name_jp")
  description String
  threads     ForumThread[]
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("forum_categories")
}

model ForumThread {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  categoryId  String        @map("category_id")
  category    ForumCategory @relation(fields: [categoryId], references: [id])
  clerkUserId String?       @map("clerk_user_id")
  authorName  String        @map("author_name")
  posts       ForumPost[]
  isPinned   Boolean       @default(false) @map("is_pinned")
  isLocked   Boolean       @default(false) @map("is_locked")
  views      Int           @default(0)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@map("forum_threads")
}

model ForumPost {
  id          String      @id @default(cuid())
  threadId    String      @map("thread_id")
  thread      ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  clerkUserId String?     @map("clerk_user_id")
  authorName  String      @map("author_name")
  content    String
  likes      Int         @default(0)
  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("forum_posts")
}

model Member {
  id           String     @id @default(cuid())
  username     String     @unique
  displayName  String     @map("display_name")
  bio          String?
  favoriteSong String?    @map("favorite_song")
  accentColor  String     @default("#ff69b4") @map("accent_color")
  role         MemberRole @default(MEMBER)
  postCount    Int        @default(0) @map("post_count")
  joinDate     DateTime   @default(now()) @map("join_date")

  @@map("members")
}

enum MemberRole {
  ADMIN
  MODERATOR
  MEMBER
}

model GuestbookEntry {
  id        String   @id @default(cuid())
  name      String
  message   String
  signature String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("guestbook_entries")
}

model SiteStats {
  id        String   @id @default("visitor_count")
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_stats")
}
